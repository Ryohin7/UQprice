# UNIQLO 比價網站 - Firebase 環境變數範例
# 部署至 Vercel 或本地開發時請複製此檔案並命名為 .env，然後填入您的 Firebase 憑證

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id

# Google Analytics 4 (GA4) 流量追蹤 ID (例如：G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# 後台管理員 Google 信箱 (多個以逗號分隔)。僅供前端顯示判斷，
# 實際權限由 firestore.rules 的 isAdmin() 白名單強制執行
VITE_ADMIN_EMAILS=admin@example.com

# Telegram 降價通知機器人 (不含 @)。機器人 Token 為機密，絕不可放在 VITE_ 變數
VITE_TELEGRAM_BOT_USERNAME=UGpricebot

# ===== 以下為後端機密，只設定在 Vercel / GitHub Actions Secrets，不要放進前端 =====
# TELEGRAM_BOT_TOKEN        Telegram 機器人 Token (爬蟲通知與 Vercel webhook 使用)
# TELEGRAM_WEBHOOK_SECRET   自訂隨機字串，用來驗證 webhook 請求確實來自 Telegram
# FIREBASE_SERVICE_ACCOUNT  Firebase 服務帳戶金鑰 JSON (Vercel webhook 綁定使用者時寫入 Firestore)
