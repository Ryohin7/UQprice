rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 驗證是否為爬蟲或管理員帳號
    function isCrawler() {
      return request.auth != null && (
        request.auth.token.email == 'crawler-bot@uqprice.com' ||
        request.auth.token.email == 'admin@uqprice.com'
      );
    }

    // ==========================================
    // 1. 商品資料庫 (products) 與 歷史價格 (product_prices)
    // ==========================================
    // 註：商品主資料已改由 public/products.json 提供，此集合不再由爬蟲寫入
    match /products/{productId} {
      // 任何造訪網站的使用者都可以讀取商品資料
      allow read: if true;
      // 僅允許爬蟲帳號進行新增、修改或刪除
      allow write: if isCrawler();
    }
    
    match /product_prices/{productId} {
      allow read: if true;
      allow write: if isCrawler();
    }

    // ==========================================
    // 2. 商品瀏覽量統計 (product_views)
    // ==========================================
    // 瀏覽次數集中在單一文件 product_views/all，結構為 { counts: { [productId]: n } }
    match /product_views/all {
      allow read: if true;
      // 前端每次只能新增或累加一個商品的計數，不可刪除欄位
      allow create: if request.resource.data.keys().hasOnly(['counts'])
                    && request.resource.data.counts.keys().size() <= 1;
      allow update: if request.resource.data.keys().hasOnly(['counts'])
                    && request.resource.data.counts.diff(resource.data.counts).affectedKeys().size() <= 1
                    && request.resource.data.counts.diff(resource.data.counts).removedKeys().size() == 0;
      allow delete: if false;
    }
    // 舊版逐商品文件 (遷移後可刪除)：僅供讀取
    match /product_views/{productId} {
      allow read: if true;
      allow write: if isCrawler();
    }
    
    // ==========================================
    // 3. 系統版本歷史 (versions)
    // ==========================================
    match /versions/{versionId} {
      allow read: if true;
      allow write: if isCrawler();
    }

    // ==========================================
    // 4. 前台導航選單 (navigation)
    // ==========================================
    match /navigation/{navigationId} {
      allow read: if true;
      allow write: if isCrawler();
    }

    // ==========================================
    // 5. 系統與爬蟲狀態 (system / crawler_reports)
    // ==========================================
    match /system/{systemId} {
      allow read: if true;
      allow write: if isCrawler();
    }

    match /crawler_reports/{reportId} {
      allow read: if true;
      allow write: if isCrawler();
    }

    // ==========================================
    // 6. 期間限定商品快速索引 (campaign_products)
    // ==========================================
    match /campaign_products/{campaignId} {
      allow read: if true;
      allow write: if isCrawler();
    }
  }
}
