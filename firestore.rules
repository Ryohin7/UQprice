rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 爬蟲機器人帳號 (Email/Password，供 GitHub Actions 使用)
    function isCrawler() {
      return request.auth != null
        && request.auth.token.email == 'crawler-bot@uqprice.com';
    }

    // 後台管理員：僅限白名單內、已驗證的 Google 帳號 (新增管理員請在此加入信箱)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jacky4976@gmail.com'
        ];
    }

    function isStaff() {
      return isCrawler() || isAdmin();
    }

    // ==========================================
    // 1. 商品資料庫 (products) 與 歷史價格 (product_prices)
    // ==========================================
    // 註：商品主資料已改由 public/products.json 提供，此集合不再由爬蟲寫入
    match /products/{productId} {
      // 任何造訪網站的使用者都可以讀取商品資料
      allow read: if true;
      // 僅允許爬蟲帳號進行新增、修改或刪除
      allow write: if isStaff();
    }
    
    match /product_prices/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // 2. 商品瀏覽量統計 (product_views)
    // ==========================================
    // 瀏覽次數分散在 shard_0 ~ shard_7，結構為 { counts: { [productId]: n } }
    // (分片數量需與 src/utils/viewCounts.js 的 VIEW_SHARDS 一致)
    match /product_views/{docId} {
      allow read: if true;
      // 前端每次只能新增或累加一個商品的計數，不可刪除欄位
      allow create: if docId.matches('shard_[0-7]')
                    && request.resource.data.keys().hasOnly(['counts'])
                    && request.resource.data.counts.keys().size() <= 1;
      allow update: if docId.matches('shard_[0-7]')
                    && request.resource.data.keys().hasOnly(['counts'])
                    && request.resource.data.counts.diff(resource.data.counts).affectedKeys().size() <= 1
                    && request.resource.data.counts.diff(resource.data.counts).removedKeys().size() == 0;
      // 舊版 (all 與逐商品文件) 僅供管理員維護
      allow write: if isStaff();
    }

    // ==========================================
    // 3. 系統版本歷史 (versions)
    // ==========================================
    match /versions/{versionId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // 4. 前台導航選單 (navigation)
    // ==========================================
    match /navigation/{navigationId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // 5. 系統與爬蟲狀態 (system / crawler_reports)
    // ==========================================
    match /system/{systemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /crawler_reports/{reportId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // 6. 期間限定商品快速索引 (campaign_products)
    // ==========================================
    match /campaign_products/{campaignId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ==========================================
    // 7. 使用者資料 (users)：追蹤清單與 Telegram 綁定
    // ==========================================
    // telegram 欄位只允許後端 (Admin SDK) 寫入，前端僅能改 favorites 與 linkCode，
    // 避免使用者把通知導向他人的 Telegram。
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isCrawler());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['favorites', 'linkCode'])
                    && request.resource.data.get('favorites', []) is list
                    && request.resource.data.get('favorites', []).size() <= 300;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favorites', 'linkCode'])
                    && request.resource.data.get('favorites', []) is list
                    && request.resource.data.get('favorites', []).size() <= 300;
      allow delete: if false;
    }
  }
}
